APP_NAME=ALIAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal) (STANDAR-TEKNIS §1b)
APP_KODE=alias
APP_URL=http://localhost:8018

# Login panel: http://localhost:8018/admin
# Super Admin — email: superadmin@alias.test / password: siliwangi
# Demo user  — email: user@alias.test / password: password

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (dijangkau container lewat host.docker.internal); SQLite tidak dipakai.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_alias
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=alias_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=alias_cache_

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=alias-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alias@unsil.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=Asia/Jakarta

APP_VERSION=1.0.0

ALIAS_DOMAIN_PENDEK=
ALIAS_DOMAIN_PANEL=
ALIAS_DOMAIN_SUREL=unsil.ac.id,staff.unsil.ac.id
# MFA dihentikan sementara (BR-34); ubah ke true untuk mengaktifkan kembali
ALIAS_MFA_AKTIF=false
ALIAS_DOMAIN_INTERNAL_DIIZINKAN=*.unsil.ac.id
ALIAS_NAMESPACE_UNIT=false
ALIAS_CACHE_LOOKUP=false
ALIAS_LOGIN_GOOGLE=false
SEED_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TRUSTED_PROXIES=
ALIAS_LAJU_PENGALIHAN=300
ALIAS_BASE_PATH=
