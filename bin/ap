#!/usr/bin/env bash
# Menjalankan perintah PHP di container. Memakai container alias-php (compose bersama) bila berjalan;
# selain itu image lokal sekali pakai (host WSL tidak punya mbstring/sqlite).
cd "$(dirname "$0")/.."
if docker ps --format '{{.Names}}' | grep -qx alias-php; then
  exec docker exec -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer alias-php "$@"
fi
IMAGE="${ALIAS_PHP_IMAGE:-code-alias-php}"
exec docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
  -v "$PWD":/var/www/html -w /var/www/html --entrypoint "$1" "$IMAGE" "${@:2}"
