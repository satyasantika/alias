# Alias FKIP — contoh konfigurasi PRODUKSI. Salin menjadi .env.production dan isi nilai rahasia di server
# (JANGAN dikomit). Tidak ada rahasia pada berkas ini.
APP_NAME=ALIAS
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=alias
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dipasang di sub-path situs dukungan FKIP: https://supportfkip.unsil.ac.id/alias (URL pendek = APP_URL/<kode>).
APP_URL=https://supportfkip.unsil.ac.id/alias
ALIAS_BASE_PATH=/alias
SESSION_PATH=/alias
APP_VERSION=1.0.0
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Domain (perlu verifikasi UPT TIK): domain pendek untuk tautan, domain panel untuk pengelolaan.
# Mode satu domain + sub-path: biarkan kosong. (Mode domain terpisah: go.fkip.unsil.ac.id / alias.fkip.unsil.ac.id.)
ALIAS_DOMAIN_PENDEK=
ALIAS_DOMAIN_PANEL=
ALIAS_DOMAIN_SUREL=unsil.ac.id,staff.unsil.ac.id
# MFA dihentikan sementara (BR-34); ubah ke true untuk mengaktifkan kembali
ALIAS_MFA_AKTIF=false
ALIAS_NAMESPACE_UNIT=false
ALIAS_CACHE_LOOKUP=false
ALIAS_LOGIN_GOOGLE=false
# Permintaan pengalihan/menit per IP. Naikkan bila NAT kampus membuat banyak pengguna berbagi satu IP.
ALIAS_LAJU_PENGALIHAN=300
# IP/CIDR reverse proxy kampus, dipisah koma (atau "*" hanya bila proxy tepercaya sepenuhnya).
TRUSTED_PROXIES=
NGINX_REAL_IP_FROM=
NGINX_SERVER_NAMES=supportfkip.unsil.ac.id
NGINX_BASE_PATH=/alias

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB NATIVE di host (dijangkau container lewat host.docker.internal). Buat db_alias dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_alias
DB_USERNAME=app
DB_PASSWORD=

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.
CACHE_STORE=database
CACHE_PREFIX=alias_cache_
SESSION_DRIVER=database
SESSION_COOKIE=alias_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=alias@fkip.unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# Hanya untuk staging/UAT (alias:siapkan-uat); kosongkan di produksi.
SEED_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
