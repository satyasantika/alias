# Alias FKIP — contoh konfigurasi PRODUKSI. Salin menjadi .env.production dan isi nilai rahasia di server
# (JANGAN dikomit). Tidak ada rahasia pada berkas ini.
APP_NAME=ALIAS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alias.fkip.unsil.ac.id
APP_VERSION=1.0.0
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Domain (perlu verifikasi UPT TIK): domain pendek untuk tautan, domain panel untuk pengelolaan.
ALIAS_DOMAIN_PENDEK=go.fkip.unsil.ac.id
ALIAS_DOMAIN_PANEL=alias.fkip.unsil.ac.id
ALIAS_DOMAIN_SUREL=unsil.ac.id
ALIAS_NAMESPACE_UNIT=false
ALIAS_CACHE_LOOKUP=false
ALIAS_LOGIN_GOOGLE=false
# Permintaan pengalihan/menit per IP. Naikkan bila NAT kampus membuat banyak pengguna berbagi satu IP.
ALIAS_LAJU_PENGALIHAN=300
# IP/CIDR reverse proxy kampus, dipisah koma (atau "*" hanya bila proxy tepercaya sepenuhnya).
TRUSTED_PROXIES=
NGINX_REAL_IP_FROM=
NGINX_SERVER_NAMES=go.fkip.unsil.ac.id alias.fkip.unsil.ac.id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Basis data: SQLite pada volume (MySQL dikecualikan). DB_DATABASE diatur compose.
DB_CONNECTION=sqlite

CACHE_STORE=redis
CACHE_PREFIX=alias_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=alias-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=alias@fkip.unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# Hanya untuk staging/UAT (alias:siapkan-uat); kosongkan di produksi.
SEED_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
