# Variabel diisi envsubst oleh image nginx: NGINX_REAL_IP_FROM (CIDR reverse proxy kampus), NGINX_SERVER_NAMES.
server {
    listen 80;
    server_name ${NGINX_SERVER_NAMES};
    root /var/www/html/public;
    index index.php;

    # IP klien sebenarnya dari reverse proxy kampus (juga diteruskan Laravel lewat TRUSTED_PROXIES).
    set_real_ip_from ${NGINX_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size 2M;          # impor CSV
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Tidak ada cache proxy untuk rute pengalihan: setiap klik harus mencapai aplikasi (statistik & blokir seketika).
    proxy_cache off;
    fastcgi_cache off;

    location ^~ /build/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass alias-php:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 30s;
    }

    location ~ /\.(?!well-known) { deny all; }
}
